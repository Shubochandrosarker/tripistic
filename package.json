{
  "name": "tripistic",
  "version": "2.0.0",
  "private": true,
  "description": "Tripistic \u2014 AI-native tour operations platform for independent guides and small tour operators.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:release": "tsx prisma/release.ts",
    "db:backfill": "tsx prisma/backfill-cli.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:ci": "npm run db:generate && npx prisma validate && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "9.0.3"
    },
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "date-fns": "4.4.0",
    "framer-motion": "^12.42.2",
    "geist": "1.7.2",
    "lucide-react": "0.460.0",
    "next": "15.5.21",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "9.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "22.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "22.20.1",
    "@types/nodemailer": "7.0.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.21",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.2",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
