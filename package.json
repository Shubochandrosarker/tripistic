{
  "name": "tripistic",
  "version": "0.1.0",
  "private": true,
  "description": "Tripistic — AI-native tour operations platform for independent guides and small tour operators.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
