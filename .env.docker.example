# Copy this file to .env.docker on the VPS and fill real production values.

# Hostinger external port. Use 8080 unless another app already owns it.
HTTP_PORT=8080

# PostgreSQL container credentials.
POSTGRES_DB=tripistic
POSTGRES_USER=tripistic
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Public app URL. Replace with your real domain or temporary VPS URL.
APP_URL=https://tripistic.com
NEXT_PUBLIC_APP_URL=https://tripistic.com
NEXT_PUBLIC_API_URL=https://tripistic.com/api
AUTH_URL=https://tripistic.com
AUTH_SECRET=CHANGE_ME_RUN_OPENSSL_RAND_BASE64_32

NODE_ENV=production
# Leave APP_ENVIRONMENT unset here — this is the live site. It exists so a
# staging deployment can run the same production build (NODE_ENV=production,
# required for `next start`) while opting out of production-only guards like
# the one that refuses to boot with a Stripe test-mode key. See
# lib/config/env-check.ts. Do not set this to anything but "production" (or
# leave it unset) on the real VPS deployment.
# APP_ENVIRONMENT=production
# debug | info | warn | error. Output is one JSON object per line, with
# secrets and customer addresses redacted at the logging boundary.
LOG_LEVEL=info

# Optional seed bootstrap. Migrations run automatically; seed manually if needed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Stripe is optional for boot, required for paid public bookings and SaaS billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_OPERATOR_MONTHLY=
STRIPE_PRICE_OPERATOR_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=
SUBSCRIPTION_PAYMENT_GRACE_DAYS=7
TRIPISTIC_PLATFORM_FEE_BPS=0
TRIPISTIC_CONNECT_COUNTRIES=US
STRIPE_SUCCESS_URL=https://tripistic.com
STRIPE_CANCEL_URL=https://tripistic.com
PAYMENT_PENDING_EXPIRY_MINUTES=30

# Email is optional for boot, required for real email delivery.
EMAIL_PROVIDER=
EMAIL_FROM=no-reply@tripistic.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI providers are optional until AI modules are enabled.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_URL=
AI_MODEL_DEFAULT=

# Enterprise/custom-domain settings.
ROOT_DOMAIN=tripistic.com
NEXT_PUBLIC_ROOT_DOMAIN=tripistic.com
RESERVED_PLATFORM_HOSTS=admin,api,app,assets,cdn,dashboard,docs,help,mail,status,support,www
CUSTOM_DOMAIN_CNAME_TARGET=cname.tripistic.example.com
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CUSTOM_HOSTNAME_DCV_METHOD=txt
# Shared secret for POST /api/jobs/run, the scheduled-job entry point.
# Leave it EMPTY and that route 404s for everyone — the safe default if you
# drive jobs from the `worker` container instead, which talks to the database
# directly and needs no secret. Set it only if an external scheduler must
# reach the app over HTTP.
CRON_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
DOMAIN_CRON_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
HOSTNAME_CACHE_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
HOSTNAME_CACHE_INTERNAL_URL=http://127.0.0.1:3000
HOSTNAME_EDGE_CACHE_TTL_SECONDS=60

# S3-compatible storage is optional.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# Backups. The `backup` service dumps nightly to this host directory and
# verifies every archive before pruning older ones. Local copies do not
# survive losing the VPS — sync this directory off-box.
# See docs/RUNBOOK-BACKUP-AND-ROLLBACK.md.
BACKUP_HOST_DIR=/var/backups/tripistic
BACKUP_RETENTION_DAYS=14

# Optional marketing analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
