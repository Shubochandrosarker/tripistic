# Copy this file to .env.staging on the VPS (next to .env.docker) and fill
# in real values. Staging runs the exact same Docker image as production —
# see docker-compose.staging.yml — fully isolated from it (own containers,
# own Postgres volume, own port). Its entire purpose is letting Stripe
# test-mode keys (or anything else you don't want anywhere near production)
# run against a real, live deployment.

# Distinct from prod's HTTP_PORT (8080) so both stacks can run on the VPS at
# once behind the same shared Traefik.
HTTP_PORT=8081

# PostgreSQL container credentials — a SEPARATE database from production.
# Never point this at the prod DB, and never copy live customer rows into it.
POSTGRES_DB=tripistic_staging
POSTGRES_USER=tripistic_staging
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Public staging URL. Route this hostname to HTTP_PORT in the Cloudflare
# Tunnel config, same pattern as app.tripistic.com in production.
APP_URL=https://staging.tripistic.com
NEXT_PUBLIC_APP_URL=https://staging.tripistic.com
NEXT_PUBLIC_API_URL=https://staging.tripistic.com/api
AUTH_URL=https://staging.tripistic.com
# Generate a FRESH secret — do not reuse the production AUTH_SECRET. Reusing
# a signing secret across environments is bad practice even when the
# databases are separate (the value has no reason to be shared at all).
AUTH_SECRET=CHANGE_ME_RUN_OPENSSL_RAND_BASE64_32

NODE_ENV=production
# This is the whole reason this file exists: NODE_ENV stays "production" (so
# `next start` serves the real optimized build, same as prod) while
# APP_ENVIRONMENT=staging opts this tier out of the production-only guards
# in lib/config/env-check.ts — specifically, the one that refuses to boot
# with a Stripe test-mode secret key.
APP_ENVIRONMENT=staging
# Separate concept, separate variable: this one names the environment for
# Cloudflare *platform* resources (Workers for Platforms dispatch namespace,
# Vectorize index, R2 bucket — see lib/cloudflare/config.ts and
# docs/v3/STAGING_DEPLOYMENT.md). Out of scope for this file's purpose
# (Stripe checkout validation) — left set for consistency, but every
# CLOUDFLARE_* resource below is fine to leave blank until/unless that
# broader Cloudflare-platform staging setup is actually done. Unconfigured
# reads as "Not Configured", not as an error.
CLOUDFLARE_ENVIRONMENT=staging
LOG_LEVEL=info

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# --- Stripe: TEST MODE ------------------------------------------------------
# This is the point of staging: real Stripe test-mode checkout against a real
# deployed instance, using a genuine test card, with zero production risk.
#
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are deliberately left blank in
# this committed template — fill them from wherever the operational values
# are held (never commit a real key, even a test-mode one). The 6 prices and
# the webhook endpoint below were already created in Stripe test mode on
# 2026-08-12 and are safe to fill in as-is (they are Stripe object IDs, not
# secrets) — see the Stripe billing setup doc for the full record:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SOLO_MONTHLY=price_1U3bWu2NxVQwVQa0sdfU5i7Y
STRIPE_PRICE_SOLO_YEARLY=price_1U3bWu2NxVQwVQa0hGNHIfXD
STRIPE_PRICE_OPERATOR_MONTHLY=price_1U3bWw2NxVQwVQa0MfSr6FTl
STRIPE_PRICE_OPERATOR_YEARLY=price_1U3bWx2NxVQwVQa0ALwfNEyx
STRIPE_PRICE_AGENCY_MONTHLY=price_1U3bWy2NxVQwVQa04wZBXaw9
STRIPE_PRICE_AGENCY_YEARLY=price_1U3bWz2NxVQwVQa0j5KrFkYe
# Webhook endpoint we_1U3bdO2NxVQwVQa0o82OM9kV already points at
# https://staging.tripistic.com/api/stripe/webhook — its signing secret goes
# in STRIPE_WEBHOOK_SECRET above once staging.tripistic.com resolves (Stripe
# does not require the URL to be live at endpoint-creation time, but webhook
# delivery will fail with connection errors, visible in the Stripe dashboard,
# until DNS/Tunnel routing for this hostname is in place).
SUBSCRIPTION_PAYMENT_GRACE_DAYS=7
TRIPISTIC_PLATFORM_FEE_BPS=0
TRIPISTIC_CONNECT_COUNTRIES=US
STRIPE_SUCCESS_URL=https://staging.tripistic.com
STRIPE_CANCEL_URL=https://staging.tripistic.com
PAYMENT_PENDING_EXPIRY_MINUTES=30

# Email — point this at a real provider if you want to test verification /
# confirmation emails end to end; otherwise leave blank and mail just queues.
EMAIL_PROVIDER=
EMAIL_FROM=no-reply@tripistic.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI providers — optional, mirror prod's if you also want to validate AI
# features on staging. Fine to leave blank.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_URL=

# Custom-domain / enterprise features are not staging's concern — leave blank
# unless specifically testing that surface.
ROOT_DOMAIN=tripistic.com
NEXT_PUBLIC_ROOT_DOMAIN=tripistic.com
RESERVED_PLATFORM_HOSTS=admin,api,app,assets,cdn,dashboard,docs,help,mail,status,support,www
CUSTOM_DOMAIN_CNAME_TARGET=cname.tripistic.example.com
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CUSTOM_HOSTNAME_DCV_METHOD=txt
# Leave blank — same reasoning as prod: the worker container talks to the
# database directly and needs no HTTP secret.
CRON_SECRET=
DOMAIN_CRON_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
HOSTNAME_CACHE_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
HOSTNAME_CACHE_INTERNAL_URL=http://127.0.0.1:3000
HOSTNAME_EDGE_CACHE_TTL_SECONDS=60

# S3-compatible storage — optional, leave blank unless testing uploads.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# No BACKUP_HOST_DIR here — docker-compose.staging.yml intentionally has no
# backup service. Staging holds synthetic test data only.

# Marketing analytics — leave blank. No reason to send staging traffic into
# production analytics/ad accounts.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
