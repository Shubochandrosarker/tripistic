model CustomDomain {
  id                 String             @id @default(cuid())
  workspaceId        String             @map("workspace_id")
  hostname           String             @unique
  status             CustomDomainStatus @default(pending_dns)
  verificationToken  String             @unique @map("verification_token")
  expectedCname      String             @map("expected_cname")
  provider           String             @default("manual")
  providerHostnameId String?            @unique @map("provider_hostname_id")
  providerStatus     String?            @map("provider_status")
  providerSslStatus  String?            @map("provider_ssl_status")
  providerErrors     Json               @default("[]") @map("provider_errors")
  providerTxtName    String?            @map("provider_txt_name")
  providerTxtValue   String?            @map("provider_txt_value")
  providerHttpUrl    String?            @map("provider_http_url")
  providerHttpBody   String?            @map("provider_http_body")
  redirectTo         String?            @map("redirect_to")
  cacheInvalidatedAt DateTime?          @map("cache_invalidated_at") @db.Timestamptz(6)
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)
  sslIssuedAt        DateTime?          @map("ssl_issued_at") @db.Timestamptz(6)
  lastCheckedAt      DateTime?          @map("last_checked_at") @db.Timestamptz(6)
  lastCheckMessage   String?            @map("last_check_message")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Which site this hostname serves. Null means "the workspace's default
  /// public surface", which is what every pre-V3 row means and why the column
  /// is nullable rather than backfilled: a domain added before the Site
  /// Builder existed still routes exactly as it did.
  siteId String? @map("site_id")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade. Deleting a site must not silently delete the
  /// customer's verified hostname and its issued certificate — that is hours
  /// of DNS propagation to undo a mistake. The domain survives, unbound.
  site      Site?     @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([status, lastCheckedAt])
  @@index([siteId])
  @@map("custom_domains")
}

