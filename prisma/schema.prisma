// Tripistic — Phase 1 SaaS Foundation schema
// Multi-tenancy: shared database, workspace_id row isolation.
// Conventions: cuid ids, money in integer cents, snake_case DB names, soft deletes where history matters.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  suspended
  deactivated

  @@map("user_status")
}

enum WorkspaceStatus {
  active
  suspended
  archived

  @@map("workspace_status")
}

enum BusinessType {
  solo_guide
  small_operator
  multi_guide_operator
  rental_activity_business
  multi_day_tour_operator
  agency

  @@map("business_type")
}

enum WorkspaceRole {
  workspace_owner
  workspace_admin
  guide
  staff
  viewer

  @@map("workspace_role")
}

enum MemberStatus {
  active
  suspended

  @@map("member_status")
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked

  @@map("invitation_status")
}

enum SettingType {
  string
  number
  boolean
  json

  @@map("setting_type")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  expired

  @@map("subscription_status")
}

enum SubscriptionChangeStatus {
  scheduled
  applied
  cancelled
  failed

  @@map("subscription_change_status")
}

enum TourKind {
  tour
  activity
  package

  @@map("tour_kind")
}

enum TourStatus {
  draft
  active
  archived

  @@map("tour_status")
}

enum TourVisibility {
  public
  private

  @@map("tour_visibility")
}

enum ScheduleStatus {
  active
  paused

  @@map("schedule_status")
}

enum AvailabilityStatus {
  scheduled
  cancelled

  @@map("availability_status")
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
  no_show

  @@map("booking_status")
}

enum BookingSource {
  public_direct
  manual

  @@map("booking_source")
}

enum PaymentStatus {
  requires_payment
  processing
  succeeded
  failed
  cancelled
  refunded
  partially_refunded

  @@map("payment_status")
}

enum WorkspacePaymentAccountStatus {
  not_started
  onboarding
  restricted
  enabled
  disabled

  @@map("workspace_payment_account_status")
}

enum ConsentStatus {
  subscribed
  unsubscribed
  unknown

  @@map("consent_status")
}

enum MessageChannel {
  email

  @@map("message_channel")
}

enum MessageStatus {
  queued
  sent
  /// Terminal. Delivery was attempted `maxAttempts` times, or the provider
  /// rejected the address in a way retrying cannot fix. Needs a human.
  failed
  skipped
  /// A delivery attempt failed but the failure looks transient, so another
  /// attempt is scheduled at `nextRetryAt`. Distinct from `failed` because
  /// an operator must be able to tell "we are still trying" from "this
  /// guest never got their confirmation and nothing further will happen".
  pending_retry

  @@map("message_status")
}

enum MessageTemplateKey {
  booking_confirmation
  booking_reminder
  review_request
  member_invitation
  /// Phase 8/9: sent to confirmed guests when their departure is marked delayed.
  departure_delayed
  /// Phase 7 — account security. These go to a user rather than a guest, and
  /// carry no workspace context, so they are recorded against the workspace
  /// the user belongs to only when one exists.
  email_verification
  password_reset
  password_changed

  @@map("message_template_key")
}

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  passwordHash    String?    @map("password_hash")
  authProviderId  String?    @map("auth_provider_id")
  avatarUrl       String?    @map("avatar_url")
  isPlatformAdmin Boolean    @default(false) @map("is_platform_admin")
  status          UserStatus @default(active)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  /// Bumped whenever every existing session for this user must stop working —
  /// today, a completed password reset. Sessions are stateless JWTs, so there
  /// is nothing server-side to delete; the version is stamped into the token
  /// at sign-in and re-checked against this column on every request. Without
  /// it, someone who reset their password because an attacker had it would
  /// leave that attacker logged in.
  sessionVersion  Int        @default(0) @map("session_version")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)

  authTokens                   AuthToken[]
  memberships                  WorkspaceMember[]             @relation("MemberUser")
  invitedMembers               WorkspaceMember[]             @relation("MemberInviter")
  ownedWorkspaces              Workspace[]                   @relation("WorkspaceOwner")
  invitationsSent              Invitation[]                  @relation("InvitationInviter")
  subscriptionChangesRequested SubscriptionChange[]
  paymentRefundsCreated        PaymentRefund[]
  mediaAssetsUploaded          WorkspaceMediaAsset[]         @relation("MediaAssetUploadedBy")
  storefrontsUpdated           WorkspaceStorefront[]         @relation("StorefrontUpdatedBy")
  storefrontRevisionsCreated   WorkspaceStorefrontRevision[] @relation("StorefrontRevisionCreatedBy")
  auditLogs                    AuditLog[]
  toursCreated                 Tour[]                        @relation("TourCreatedBy")
  bookingsCreated              Booking[]                     @relation("BookingCreatedBy")
  bookingStatusEvents          BookingStatusEvent[]          @relation("BookingStatusActor")
  waiverVersionsCreated        WaiverVersion[]
  leadsCreated                 Lead[]
  crmTasksCreated              CrmTask[]
  crmActivitiesLogged          CrmActivity[]
  staffTimeEntriesLogged       StaffTimeEntry[]
  guideRatingsGiven            GuideRating[]
  opsEventsActed               OpsEvent[]
  incidentReportsFiled         IncidentReport[]
  itinerariesCreated           Itinerary[]
  itineraryVersionsCreated     ItineraryVersion[]
  sitesCreated                 Site[]                        @relation("SiteCreatedBy")
  siteRevisionsCreated         SiteRevision[]                @relation("SiteRevisionCreatedBy")
  siteDeploymentsTriggered     SiteDeployment[]              @relation("SiteDeploymentTriggeredBy")
  knowledgeSourcesCreated      KnowledgeSource[]             @relation("KnowledgeSourceCreatedBy")
  aiConversations              AiConversation[]              @relation("AiConversationUser")

  @@map("users")
}

model Workspace {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  businessType BusinessType    @default(solo_guide) @map("business_type")
  ownerId      String          @map("owner_id")
  timezone     String          @default("UTC")
  currency     String          @default("USD")
  country      String?
  status       WorkspaceStatus @default(active)
  trialEndsAt  DateTime?       @map("trial_ends_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz(6)

  owner                     User                          @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members                   WorkspaceMember[]
  invitations               Invitation[]
  settings                  Setting[]
  subscriptions             Subscription[]
  subscriptionChanges       SubscriptionChange[]
  usageMeters               UsageMeter[]
  billingEvents             BillingEvent[]
  featureFlags              FeatureFlag[]
  auditLogs                 AuditLog[]
  tours                     Tour[]
  tourAddons                TourAddon[]
  tourSchedules             TourSchedule[]
  availabilities            Availability[]
  blackoutDates             BlackoutDate[]
  bookings                  Booking[]
  payments                  Payment[]
  paymentEvents             PaymentEvent[]
  paymentRefunds            PaymentRefund[]
  paymentDisputes           PaymentDispute[]
  paymentAccount            WorkspacePaymentAccount?
  customers                 Customer[]
  messages                  Message[]
  guideProfiles             GuideProfile[]
  waiverTemplate            WaiverTemplate?
  waiverVersions            WaiverVersion[]
  waiverSignatures          WaiverSignature[]
  companies                 Company[]
  leads                     Lead[]
  crmTasks                  CrmTask[]
  crmActivities             CrmActivity[]
  staffTimeOff              StaffTimeOff[]
  staffTimeEntries          StaffTimeEntry[]
  guideRatings              GuideRating[]
  vehicles                  Vehicle[]
  vehicleMaintenanceRecords VehicleMaintenanceRecord[]
  vehicleFuelLogs           VehicleFuelLog[]
  opsEvents                 OpsEvent[]
  incidentReports           IncidentReport[]
  vendors                   Vendor[]
  vendorInvoices            VendorInvoice[]
  itineraries               Itinerary[]
  itineraryDays             ItineraryDay[]
  itineraryItems            ItineraryItem[]
  itineraryVersions         ItineraryVersion[]
  whiteLabel                WorkspaceWhiteLabel?
  storefront                WorkspaceStorefront?
  mediaAssets               WorkspaceMediaAsset[]
  storefrontRevisions       WorkspaceStorefrontRevision[]
  customDomains             CustomDomain[]
  sites                     Site[]
  sitePages                 SitePage[]
  siteRevisions             SiteRevision[]
  siteDeployments           SiteDeployment[]
  knowledgeSources          KnowledgeSource[]
  knowledgeDocuments        KnowledgeDocument[]
  knowledgeChunkRefs        KnowledgeChunkRef[]
  knowledgeIndexJobs        KnowledgeIndexJob[]
  aiConversations           AiConversation[]
  aiUsageEvents             AiUsageEvent[]
  x402Payments              X402Payment[]
  x402AccessGrants          X402AccessGrant[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole @default(viewer)
  status      MemberStatus  @default(active)
  invitedById String?       @map("invited_by")
  joinedAt    DateTime      @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("MemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  guideProfile         GuideProfile?
  guidedAvailabilities Availability[]   @relation("AvailabilityGuide")
  drivenAvailabilities Availability[]   @relation("AvailabilityDriver")
  assignedCrmTasks     CrmTask[]
  assignedLeads        Lead[]
  timeOff              StaffTimeOff[]
  timeEntries          StaffTimeEntry[]
  ratings              GuideRating[]

  @@unique([workspaceId, userId])
  /// Lets Availability.guide and GuideProfile.member use the same
  /// composite-FK-for-tenant-safety pattern as the rest of the booking
  /// subtree (see Tour.@@unique([workspaceId, id])).
  @@unique([workspaceId, id])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Invitation {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  email       String
  role        WorkspaceRole    @default(viewer)
  token       String           @unique
  status      InvitationStatus @default(pending)
  invitedById String           @map("invited_by")
  expiresAt   DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt  DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@index([workspaceId])
  @@map("invitations")
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String?  @map("workspace_id")
  userId      String?  @map("user_id")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model Setting {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  key         String
  value       String
  type        SettingType @default(string)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("settings")
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  priceMonthly Int      @map("price_monthly")
  priceYearly  Int      @map("price_yearly")
  currency     String   @default("USD")
  features     Json     @default("[]")
  limits       Json     @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions           Subscription[]
  featureFlags            FeatureFlag[]
  prices                  PlanPrice[]
  entitlements            Entitlement[]
  subscriptionChangesFrom SubscriptionChange[] @relation("SubscriptionChangeFromPlan")
  subscriptionChangesTo   SubscriptionChange[] @relation("SubscriptionChangeToPlan")

  @@map("plans")
}

model PlanPrice {
  id              String   @id @default(cuid())
  planId          String   @map("plan_id")
  interval        String
  amount          Int
  currency        String   @default("USD")
  billingProvider String?  @map("billing_provider")
  providerPriceId String?  @unique @map("provider_price_id")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, interval, currency])
  @@index([planId, isActive])
  @@map("plan_prices")
}

model Entitlement {
  id         String   @id @default(cuid())
  planId     String   @map("plan_id")
  key        String
  enabled    Boolean  @default(false)
  limitValue Int?     @map("limit_value")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([key, enabled])
  @@map("entitlements")
}

model Subscription {
  id                     String             @id @default(cuid())
  workspaceId            String             @map("workspace_id")
  planId                 String             @map("plan_id")
  status                 SubscriptionStatus @default(trialing)
  billingInterval        String?            @map("billing_interval")
  billingProvider        String?            @map("billing_provider")
  providerCustomerId     String?            @map("provider_customer_id")
  providerSubscriptionId String?            @map("provider_subscription_id")
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodStart     DateTime?          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  cancelAt               DateTime?          @map("cancel_at") @db.Timestamptz(6)
  graceEndsAt            DateTime?          @map("grace_ends_at") @db.Timestamptz(6)
  lastPaymentFailedAt    DateTime?          @map("last_payment_failed_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan             Plan                 @relation(fields: [planId], references: [id], onDelete: Restrict)
  billingEvents    BillingEvent[]
  scheduledChanges SubscriptionChange[]

  @@index([workspaceId])
  @@index([planId])
  @@index([status, graceEndsAt])
  @@map("subscriptions")
}

model SubscriptionChange {
  id                 String                   @id @default(cuid())
  workspaceId        String                   @map("workspace_id")
  subscriptionId     String                   @map("subscription_id")
  fromPlanId         String?                  @map("from_plan_id")
  toPlanId           String                   @map("to_plan_id")
  interval           String
  providerScheduleId String?                  @unique @map("provider_schedule_id")
  status             SubscriptionChangeStatus @default(scheduled)
  effectiveAt        DateTime                 @map("effective_at") @db.Timestamptz(6)
  requestedById      String?                  @map("requested_by")
  appliedAt          DateTime?                @map("applied_at") @db.Timestamptz(6)
  cancelledAt        DateTime?                @map("cancelled_at") @db.Timestamptz(6)
  metadata           Json                     @default("{}")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromPlan     Plan?        @relation("SubscriptionChangeFromPlan", fields: [fromPlanId], references: [id], onDelete: SetNull)
  toPlan       Plan         @relation("SubscriptionChangeToPlan", fields: [toPlanId], references: [id], onDelete: Restrict)
  requestedBy  User?        @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, effectiveAt])
  @@index([subscriptionId, status])
  @@index([toPlanId])
  @@index([requestedById])
  @@map("subscription_changes")
}

model BillingEvent {
  id              String    @id @default(cuid())
  workspaceId     String?   @map("workspace_id")
  subscriptionId  String?   @map("subscription_id")
  provider        String
  providerEventId String    @unique @map("provider_event_id")
  eventType       String    @map("event_type")
  payload         Json
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([subscriptionId])
  @@index([eventType])
  @@map("billing_events")
}

model UsageMeter {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  key         String
  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(6)
  used        Int      @default(0)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key, periodStart, periodEnd])
  @@index([workspaceId, key, periodEnd])
  @@map("usage_meters")
}

model Tour {
  id                      String         @id @default(cuid())
  workspaceId             String         @map("workspace_id")
  title                   String
  slug                    String
  kind                    TourKind       @default(tour)
  description             String?
  durationMinutes         Int            @map("duration_minutes")
  durationDays            Int?           @map("duration_days")
  location                String?
  meetingPoint            String?        @map("meeting_point")
  capacity                Int            @default(10)
  basePrice               Int            @map("base_price")
  currency                String         @default("USD")
  visibility              TourVisibility @default(public)
  status                  TourStatus     @default(draft)
  cancellationPolicy      String?        @map("cancellation_policy")
  cancellationNoticeHours Int?           @map("cancellation_notice_hours")
  waiverRequired          Boolean        @default(false) @map("waiver_required")
  coverImageUrl           String?        @map("cover_image_url")
  createdById             String?        @map("created_by")
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?      @map("deleted_at") @db.Timestamptz(6)

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("TourCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  addons         TourAddon[]
  schedules      TourSchedule[]
  availabilities Availability[]
  blackoutDates  BlackoutDate[]
  itineraryItems ItineraryItem[]
  bookings       Booking[]

  @@unique([workspaceId, slug])
  /// Lets Booking relate via the composite (workspace_id, tour_id) FK below
  /// instead of a plain single-column one — makes "a booking referencing a
  /// tour from a different workspace" a database constraint violation, not
  /// just an application bug.
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@map("tours")
}

model TourAddon {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  tourId        String   @map("tour_id")
  name          String
  description   String?
  price         Int
  maxPerBooking Int?     @map("max_per_booking")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tour              Tour                    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookingSelections BookingAddonSelection[]

  @@index([workspaceId])
  @@index([tourId])
  @@map("tour_addons")
}

model TourSchedule {
  id              String         @id @default(cuid())
  workspaceId     String         @map("workspace_id")
  tourId          String         @map("tour_id")
  name            String?
  daysOfWeek      Int[]          @map("days_of_week")
  startTime       String         @map("start_time")
  durationMinutes Int?           @map("duration_minutes")
  capacity        Int?
  startsOn        DateTime       @map("starts_on") @db.Date
  endsOn          DateTime?      @map("ends_on") @db.Date
  status          ScheduleStatus @default(active)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tour           Tour           @relation(fields: [tourId], references: [id], onDelete: Cascade)
  availabilities Availability[]

  @@index([workspaceId])
  @@index([tourId])
  @@map("tour_schedules")
}

/// Capacity invariants (`capacity` > 0, `booked_count` >= 0, `booked_count` <=
/// `capacity`) are enforced by named PostgreSQL CHECK constraints added via
/// hand-written SQL in migration `20260710193000_availability_capacity_constraints`.
/// Prisma's schema DSL has no check-constraint syntax, so they are not (and
/// cannot be) represented here — see that migration's `migration.sql`.
model Availability {
  id            String             @id @default(cuid())
  workspaceId   String             @map("workspace_id")
  tourId        String             @map("tour_id")
  scheduleId    String?            @map("schedule_id")
  startsAt      DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime           @map("ends_at") @db.Timestamptz(6)
  capacity      Int
  bookedCount   Int                @default(0) @map("booked_count")
  priceOverride Int?               @map("price_override")
  guideId       String?            @map("guide_id")
  status        AvailabilityStatus @default(scheduled)
  notes         String?
  /// Phase 7: one vehicle per departure — same optional-assignment shape as
  /// guideId.
  vehicleId     String?            @map("vehicle_id")
  /// Phase 6 (extended): one driver per departure, separate from guideId so
  /// a departure can have both a tour guide and a dedicated driver.
  driverId      String?            @map("driver_id")
  /// Phase 8/9: live operations status — independent of `status` above,
  /// which governs bookability, not day-of-departure state.
  opsStatus     OpsStatus          @default(scheduled) @map("ops_status")
  delayMinutes  Int?               @map("delay_minutes")
  opsUpdatedAt  DateTime?          @map("ops_updated_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tour             Tour             @relation(fields: [tourId], references: [id], onDelete: Cascade)
  schedule         TourSchedule?    @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  bookings         Booking[]
  /// Phase 6: one guide per departure (reserved since Phase 2, wired up
  /// here). `onDelete: Restrict`, not `SetNull` — same reason as
  /// Booking.customer: a composite FK cannot null a required column
  /// (workspace_id). Member removal explicitly clears this field first
  /// (see app/api/workspaces/[id]/members/[memberId]/route.ts) so Restrict
  /// never actually blocks removing a former guide.
  guide            WorkspaceMember? @relation("AvailabilityGuide", fields: [workspaceId, guideId], references: [workspaceId, id], onDelete: Restrict)
  /// Same reasoning/pattern as `guide` above — member removal clears this
  /// field first too (lib/workforce/service.ts `clearDriverAssignments`).
  driver           WorkspaceMember? @relation("AvailabilityDriver", fields: [workspaceId, driverId], references: [workspaceId, id], onDelete: Restrict)
  /// Vehicle is never hard-deleted (soft-delete only), so Restrict here
  /// never blocks anything in practice — same reasoning as Lead.company.
  vehicle          Vehicle?         @relation(fields: [workspaceId, vehicleId], references: [workspaceId, id], onDelete: Restrict)
  opsEvents        OpsEvent[]
  incidentReports  IncidentReport[]
  staffTimeEntries StaffTimeEntry[]
  guideRatings     GuideRating[]

  @@unique([tourId, startsAt])
  /// See the matching comment on Tour.@@unique([workspaceId, id]) — same
  /// composite-FK-for-tenant-safety pattern, used by Booking.availability.
  @@unique([workspaceId, id])
  @@index([workspaceId, startsAt])
  @@index([tourId, startsAt])
  @@index([workspaceId, opsStatus, startsAt])
  @@map("availabilities")
}

model BlackoutDate {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  tourId      String?  @map("tour_id")
  startsOn    DateTime @map("starts_on") @db.Date
  endsOn      DateTime @map("ends_on") @db.Date
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tour      Tour?     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("blackout_dates")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  workspaceId String?  @map("workspace_id")
  planId      String?  @map("plan_id")
  featureKey  String   @map("feature_key")
  enabled     Boolean  @default(false)
  limitValue  Int?     @map("limit_value")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan?      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([workspaceId, featureKey])
  @@index([planId, featureKey])
  @@map("feature_flags")
}

/**
 * ------------------------------------------------------------------------
 */
/**
 * Phase 3 — booking engine
 */
/**
 * ------------------------------------------------------------------------
 */

/// A booking is never hard-deleted through the normal UI/API — cancellation
/// is a status transition, not a delete. `tour`/`availability` use composite
/// (workspace_id, ...) foreign keys (see Tour/Availability `@@unique`s above)
/// so a booking referencing a resource from a different workspace is
/// rejected by Postgres, not only by application guards. `onDelete: Restrict`
/// on both means a Tour/Availability can never be hard-deleted while
/// bookings reference it — soft-delete/archive remains the only path.
model Booking {
  id             String        @id @default(cuid())
  workspaceId    String        @map("workspace_id")
  tourId         String        @map("tour_id")
  availabilityId String        @map("availability_id")
  reference      String
  publicToken    String        @unique @map("public_token")
  idempotencyKey String?       @map("idempotency_key")
  source         BookingSource @default(public_direct)
  status         BookingStatus @default(pending)

  guestFirstName   String  @map("guest_first_name")
  guestLastName    String  @map("guest_last_name")
  guestEmail       String  @map("guest_email")
  guestPhone       String? @map("guest_phone")
  guestNotes       String? @map("guest_notes")
  operatorNotes    String? @map("operator_notes")
  participantCount Int     @map("participant_count")

  tourTitleSnapshot    String   @map("tour_title_snapshot")
  locationSnapshot     String?  @map("location_snapshot")
  meetingPointSnapshot String?  @map("meeting_point_snapshot")
  departureStartsAt    DateTime @map("departure_starts_at") @db.Timestamptz(6)
  departureEndsAt      DateTime @map("departure_ends_at") @db.Timestamptz(6)

  unitPrice   Int    @map("unit_price")
  subtotal    Int
  addonsTotal Int    @map("addons_total")
  totalAmount Int    @map("total_amount")
  currency    String

  cancellationPolicySnapshot String?   @map("cancellation_policy_snapshot")
  termsAcceptedAt            DateTime  @map("terms_accepted_at") @db.Timestamptz(6)
  confirmedAt                DateTime? @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt                DateTime? @map("cancelled_at") @db.Timestamptz(6)
  completedAt                DateTime? @map("completed_at") @db.Timestamptz(6)

  createdById String?   @map("created_by")
  /// Backfilled by createBooking() — deduped/upserted by (workspace_id,
  /// email), never set directly by a caller. See lib/messaging/service.ts.
  customerId  String?   @map("customer_id")
  /// Phase 8 Operations Center: set when the guest is checked in at
  /// departure. Independent of `status` — a booking stays `confirmed`
  /// through check-in; this is a separate day-of-departure signal.
  checkedInAt DateTime? @map("checked_in_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  tour             Tour                    @relation(fields: [workspaceId, tourId], references: [workspaceId, id], onDelete: Restrict)
  availability     Availability            @relation(fields: [workspaceId, availabilityId], references: [workspaceId, id], onDelete: Restrict)
  createdBy        User?                   @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  customer         Customer?               @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  participants     BookingParticipant[]
  addonSelections  BookingAddonSelection[]
  statusEvents     BookingStatusEvent[]
  payments         Payment[]
  messages         Message[]
  waiverSignatures WaiverSignature[]

  @@unique([workspaceId, reference])
  @@unique([workspaceId, idempotencyKey])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, createdAt])
  @@index([availabilityId, status])
  @@index([workspaceId, guestEmail])
  @@index([workspaceId, tourId])
  @@index([workspaceId, customerId])
  @@map("bookings")
}

/// Participant row 1 may be the lead guest (MVP rule — see docs/14 §3). Count
/// must equal the booking's `participantCount`.
model BookingParticipant {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  bookingId   String   @map("booking_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  email       String?
  phone       String?
  notes       String?
  isLead      Boolean  @default(false) @map("is_lead")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking         Booking          @relation(fields: [workspaceId, bookingId], references: [workspaceId, id], onDelete: Cascade)
  waiverSignature WaiverSignature?

  /// Lets WaiverSignature.participant use the same composite-FK-for-
  /// tenant-safety pattern as the rest of the booking subtree.
  @@unique([workspaceId, id])
  @@index([workspaceId, bookingId])
  @@map("booking_participants")
}

/// Snapshot of a selected add-on at booking time. `tourAddon` may later be
/// deleted (SetNull) — the snapshot fields remain the source of truth.
model BookingAddonSelection {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  bookingId    String   @map("booking_id")
  tourAddonId  String?  @map("tour_addon_id")
  nameSnapshot String   @map("name_snapshot")
  unitPrice    Int      @map("unit_price")
  quantity     Int
  totalPrice   Int      @map("total_price")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking   Booking    @relation(fields: [workspaceId, bookingId], references: [workspaceId, id], onDelete: Cascade)
  tourAddon TourAddon? @relation(fields: [tourAddonId], references: [id], onDelete: SetNull)

  @@index([workspaceId, bookingId])
  @@index([tourAddonId])
  @@map("booking_addon_selections")
}

/// Append-only status history — one row per transition. `actorUserId` is
/// null for public (unauthenticated) creation/transitions.
model BookingStatusEvent {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  bookingId   String         @map("booking_id")
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus  @map("to_status")
  actorUserId String?        @map("actor_user_id")
  note        String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [workspaceId, bookingId], references: [workspaceId, id], onDelete: Cascade)
  actor   User?   @relation("BookingStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, bookingId, createdAt])
  @@map("booking_status_events")
}

/**
 * ------------------------------------------------------------------------
 */
/**
 * Phase 4 — Stripe payments
 */
/**
 * ------------------------------------------------------------------------
 */

/// One booking may accumulate more than one Payment row over its life (a
/// failed or expired attempt followed by a retry creates a fresh row rather
/// than mutating a settled one). "The current payment" for a booking is the
/// latest row by `createdAt`. `booking` uses the same composite
/// (workspace_id, ...) foreign key pattern as the rest of the booking
/// subtree, so a payment can never reference a booking from another tenant.
model Payment {
  id                         String        @id @default(cuid())
  workspaceId                String        @map("workspace_id")
  bookingId                  String        @map("booking_id")
  paymentAccountId           String?       @map("payment_account_id")
  provider                   String        @default("stripe")
  providerPaymentIntentId    String?       @map("provider_payment_intent_id")
  providerCheckoutSessionId  String?       @map("provider_checkout_session_id")
  providerChargeId           String?       @map("provider_charge_id")
  providerTransferId         String?       @map("provider_transfer_id")
  providerBalanceTxnId       String?       @map("provider_balance_txn_id")
  providerConnectedAccountId String?       @map("provider_connected_account_id")
  amount                     Int
  currency                   String
  platformFeeAmount          Int           @default(0) @map("platform_fee_amount")
  stripeFeeAmount            Int?          @map("stripe_fee_amount")
  status                     PaymentStatus @default(requires_payment)
  paymentMethod              String?       @map("payment_method")
  receiptUrl                 String?       @map("receipt_url")
  failureCode                String?       @map("failure_code")
  failureMessage             String?       @map("failure_message")
  refundedAmount             Int?          @map("refunded_amount")
  /// End of this payment attempt's window (Checkout Session expiry / our own
  /// unpaid-booking hold). The expiration sweep in lib/payments/expiration.ts
  /// targets rows where this has passed and status is still unsettled.
  expiresAt                  DateTime?     @map("expires_at") @db.Timestamptz(6)
  /// Non-sensitive cache only — e.g. the last-created Checkout Session URL,
  /// so a guest reloading the confirmation page doesn't require a fresh
  /// Stripe API call to redisplay the same link. Never card data.
  metadata                   Json?
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  booking        Booking                  @relation(fields: [workspaceId, bookingId], references: [workspaceId, id], onDelete: Cascade)
  paymentAccount WorkspacePaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull)
  events         PaymentEvent[]
  refunds        PaymentRefund[]
  disputes       PaymentDispute[]

  @@index([workspaceId, bookingId])
  @@index([paymentAccountId])
  @@index([providerPaymentIntentId])
  @@index([providerCheckoutSessionId])
  @@index([providerConnectedAccountId])
  @@map("payments")
}

model PaymentRefund {
  id                   String   @id @default(cuid())
  workspaceId          String   @map("workspace_id")
  paymentId            String   @map("payment_id")
  provider             String   @default("stripe")
  providerRefundId     String   @unique @map("provider_refund_id")
  providerBalanceTxnId String?  @map("provider_balance_txn_id")
  amount               Int
  currency             String
  status               String
  reason               String?
  createdById          String?  @map("created_by")
  metadata             Json     @default("{}")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payment   Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([paymentId])
  @@index([createdById])
  @@map("payment_refunds")
}

model PaymentDispute {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  paymentId         String?   @map("payment_id")
  provider          String    @default("stripe")
  providerDisputeId String    @unique @map("provider_dispute_id")
  providerChargeId  String?   @map("provider_charge_id")
  amount            Int
  currency          String
  status            String
  reason            String?
  evidenceDueBy     DateTime? @map("evidence_due_by") @db.Timestamptz(6)
  createdAtStripe   DateTime? @map("created_at_stripe") @db.Timestamptz(6)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(6)
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payment   Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([paymentId])
  @@index([providerChargeId])
  @@map("payment_disputes")
}

model WorkspacePaymentAccount {
  id                String                        @id @default(cuid())
  workspaceId       String                        @unique @map("workspace_id")
  provider          String                        @default("stripe")
  providerAccountId String                        @unique @map("provider_account_id")
  accountType       String                        @default("express") @map("account_type")
  status            WorkspacePaymentAccountStatus @default(onboarding)
  country           String?
  defaultCurrency   String?                       @map("default_currency")
  chargesEnabled    Boolean                       @default(false) @map("charges_enabled")
  payoutsEnabled    Boolean                       @default(false) @map("payouts_enabled")
  detailsSubmitted  Boolean                       @default(false) @map("details_submitted")
  platformFeeBps    Int                           @default(0) @map("platform_fee_bps")
  disabledReason    String?                       @map("disabled_reason")
  requirements      Json                          @default("{}")
  capabilities      Json                          @default("{}")
  lastSyncedAt      DateTime?                     @map("last_synced_at") @db.Timestamptz(6)
  createdAt         DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  payments  Payment[]

  @@index([status, chargesEnabled, payoutsEnabled])
  @@map("workspace_payment_accounts")
}

/// Append-only webhook receipt log. `providerEventId` is globally unique per
/// Stripe event and is the sole idempotency guard for webhook processing —
/// a redelivered event hits this constraint and is a safe no-op, the same
/// "prove exactly-once via a DB unique constraint" pattern used for booking
/// idempotency keys. `workspaceId`/`paymentId`/`bookingId` are nullable so an
/// event that cannot be mapped to a known payment (wrong Stripe
/// account/mode, an event type we don't track a payment for) is still
/// recorded rather than silently dropped.
model PaymentEvent {
  id                String    @id @default(cuid())
  workspaceId       String?   @map("workspace_id")
  paymentId         String?   @map("payment_id")
  bookingId         String?   @map("booking_id")
  provider          String    @default("stripe")
  providerEventId   String    @unique @map("provider_event_id")
  providerAccountId String?   @map("provider_account_id")
  eventType         String    @map("event_type")
  payload           Json
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  payment   Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([bookingId])
  @@map("payment_events")
}

/**
 * ------------------------------------------------------------------------
 */
/**
 * Phase 5 — CRM & communication
 */
/**
 * ------------------------------------------------------------------------
 */

/// Auto-created/updated by createBooking() (deduped by workspace_id+email,
/// case-insensitive — the email is always lowercased before the lookup) —
/// never created directly through a public-facing form. `@@unique` on
/// (workspace_id, id) lets Booking.customer use the same composite
/// tenant-safe foreign key pattern as the rest of the booking subtree.
model Customer {
  id            String        @id @default(cuid())
  workspaceId   String        @map("workspace_id")
  companyId     String?       @map("company_id")
  name          String
  email         String
  phone         String?
  country       String?
  tags          String[]      @default([])
  consentStatus ConsentStatus @default(unknown) @map("consent_status")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(6)

  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// onDelete: Restrict, not SetNull — a composite FK can't null a required
  /// workspace_id column (same reasoning as Availability.guide). Company is
  /// never hard-deleted through the app (soft-delete only), so this never
  /// actually blocks anything in practice.
  company            Company?      @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: Restrict)
  bookings           Booking[]
  messages           Message[]
  crmTasks           CrmTask[]
  crmActivities      CrmActivity[]
  convertedFromLeads Lead[]
  itineraries        Itinerary[]

  @@unique([workspaceId, email])
  @@unique([workspaceId, id])
  @@index([workspaceId, consentStatus])
  @@index([workspaceId, companyId])
  @@map("customers")
}

/// Append-only send-tracking log — one row per attempted message, not just
/// successful ones (`status: failed`/`skipped` are recorded, not silently
/// dropped, so "did this guest actually get their confirmation email" is
/// always answerable). `bookingId`/`customerId` are nullable and not
/// composite-FK'd to their parents (unlike the rest of the booking
/// subtree) — this table is an observability log first, matching
/// `AuditLog`'s existing nullable-FK precedent, not a strict child record.
model Message {
  id                String             @id @default(cuid())
  workspaceId       String             @map("workspace_id")
  bookingId         String?            @map("booking_id")
  customerId        String?            @map("customer_id")
  channel           MessageChannel     @default(email)
  templateKey       MessageTemplateKey @map("template_key")
  status            MessageStatus      @default(queued)
  toEmail           String?            @map("to_email")
  subject           String?
  providerMessageId String?            @map("provider_message_id")
  errorMessage      String?            @map("error_message")
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// How many delivery attempts have been made. Incremented on every attempt,
  /// success or failure, so the history is honest about how much work a
  /// message took rather than only recording the final outcome.
  attempts      Int       @default(0)
  /// Attempts allowed before the message becomes terminally `failed`. Stored
  /// per row rather than read from config at retry time so raising the global
  /// limit cannot silently resurrect messages an operator already triaged.
  maxAttempts   Int       @default(5) @map("max_attempts")
  /// When the retry sweep may next attempt this message. Null for anything
  /// not awaiting a retry.
  nextRetryAt   DateTime? @map("next_retry_at") @db.Timestamptz(6)
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  /// Stable identity for "this exact message to this exact recipient".
  /// Unique, so a retry sweep racing a send site — or a job that runs twice
  /// because a tick overlapped — cannot produce two confirmation emails for
  /// one booking. Nullable and unique: Postgres treats NULLs as distinct in a
  /// unique index, so rows predating the outbox (and the deliberately
  /// unkeyed ones, like a per-recipient delay notice) coexist freely while
  /// every keyed message is still enforced exactly once.
  dedupeKey     String?   @unique @map("dedupe_key")
  /// The rendered body, kept only while a retry is still possible so the
  /// sweep can resend without re-deriving it from data that may since have
  /// changed. Cleared on success or terminal failure — see
  /// `lib/messaging/outbox.ts` for why holding guest PII here indefinitely
  /// would be wrong.
  payload       Json?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  booking   Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([workspaceId, bookingId])
  /// "Has this booking already received a sent reminder/confirmation?" —
  /// the dedupe guard the reminder sweep and each send-site check first.
  @@index([workspaceId, templateKey, bookingId])
  /// Drives the retry sweep's candidate query.
  @@index([status, nextRetryAt])
  @@map("messages")
}

/**
 * ------------------------------------------------------------------------
 */
/**
 * Phase 6 — Guides & waivers
 */
/**
 * ------------------------------------------------------------------------
 */

/// Certifications/notes for a workspace member who leads tours. Deliberately
/// not restricted to role: guide — an owner or staff member who personally
/// guides trips (docs/01's "Sofia — solo guide" persona) can have one too.
/// Created lazily (upsert) the first time an operator records anything for
/// a member.
model GuideProfile {
  id              String              @id @default(cuid())
  workspaceId     String              @map("workspace_id")
  memberId        String              @map("member_id")
  certifications  String[]            @default([])
  notes           String?
  /// Phase 6 (extended) — workforce management fields. All additive with
  /// safe defaults so every existing row remains valid unmigrated data.
  kind            GuideKind           @default(guide)
  languages       String[]            @default([])
  skills          String[]            @default([])
  employmentType  StaffEmploymentType @default(employee) @map("employment_type")
  phone           String?
  hourlyRateCents Int?                @map("hourly_rate_cents")
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [workspaceId, memberId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, memberId])
  @@map("guide_profiles")
}

/// One per workspace — a true singleton, get-or-create on first write.
/// Holds no text itself; every version of the actual waiver text lives on
/// WaiverVersion below.
model WaiverTemplate {
  id          String   @id @default(cuid())
  workspaceId String   @unique @map("workspace_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions  WaiverVersion[]

  /// Redundant with the column-level @unique above for uniqueness purposes;
  /// required so WaiverVersion.template can use the same composite-FK
  /// pattern as the rest of the booking subtree.
  @@unique([workspaceId, id])
  @@map("waiver_templates")
}

/// Immutable once created — no update route exists for this model at all.
/// Editing the waiver creates a new version; old versions are retained
/// forever so an already-signed WaiverSignature keeps pointing at the exact
/// text its signer actually agreed to (docs/07 §4: "Waiver text versions
/// are immutable; edits create new versions"). "The active version" is
/// derived (highest versionNumber for the template), never a separate
/// isActive flag that could drift out of sync.
model WaiverVersion {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  templateId    String   @map("template_id")
  versionNumber Int      @map("version_number")
  title         String
  bodyText      String   @map("body_text")
  createdById   String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template   WaiverTemplate    @relation(fields: [workspaceId, templateId], references: [workspaceId, id], onDelete: Cascade)
  createdBy  User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  signatures WaiverSignature[]

  @@unique([workspaceId, templateId, versionNumber])
  @@unique([workspaceId, id])
  @@index([workspaceId, templateId])
  @@map("waiver_versions")
}

/// One per participant, permanently (docs/02 §6 AC: "signed waiver attaches
/// to participant") — a participant who signs stays signed even if the
/// template is later revised; there is no forced-re-sign flow. signerName
/// is whoever actually held the pen (e.g. a parent signing for a minor
/// participant), not necessarily identical to the participant's own name.
/// signatureImage is a `data:image/png;base64,...` data URL — no object
/// storage integration exists anywhere in this app yet (.env.example's
/// STORAGE_* vars are still placeholders), so this follows the same
/// pragmatic shortcut Tour.coverImageUrl already takes.
/**
 * ------------------------------------------------------------------------
 */
/**
 * Phase 5 (extended) — CRM: companies, leads, tasks, activity timeline
 */
/**
 * ------------------------------------------------------------------------
 */

enum CompanyKind {
  travel_agent
  hotel
  partner
  other

  @@map("company_kind")
}

enum LeadStatus {
  new
  contacted
  qualified
  proposal_sent
  won
  lost

  @@map("lead_status")
}

enum CrmTaskStatus {
  open
  done

  @@map("crm_task_status")
}

enum CrmActivityType {
  note
  call
  email
  whatsapp
  sms
  meeting
  status_change

  @@map("crm_activity_type")
}

/// Directory of external relationships a workspace deals with — travel
/// agents, hotels, and other partners — as distinct from `Customer`, which
/// is always an actual guest. A `Customer` or `Lead` may optionally belong
/// to one (e.g. a guest who books through a travel agent).
model Company {
  id                String      @id @default(cuid())
  workspaceId       String      @map("workspace_id")
  name              String
  kind              CompanyKind @default(other)
  email             String?
  phone             String?
  website           String?
  country           String?
  commissionRateBps Int?        @map("commission_rate_bps")
  notes             String?
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?   @map("deleted_at") @db.Timestamptz(6)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customers Customer[]
  leads     Lead[]

  @@unique([workspaceId, id])
  @@index([workspaceId, kind])
  @@map("companies")
}

/// Pre-booking pipeline: a prospective guest who hasn't booked yet.
/// `convertedCustomerId` is set once a lead becomes a real booking-backed
/// `Customer` (see lib/crm/leads.ts `convertLead`) — the Lead row is kept
/// (not deleted) as pipeline history rather than being replaced.
model Lead {
  id                  String     @id @default(cuid())
  workspaceId         String     @map("workspace_id")
  name                String
  email               String?
  phone               String?
  companyId           String?    @map("company_id")
  source              String?
  status              LeadStatus @default(new)
  estimatedValueCents Int?       @map("estimated_value_cents")
  currency            String     @default("USD")
  tags                String[]   @default([])
  notes               String?
  convertedCustomerId String?    @map("converted_customer_id")
  assignedToId        String?    @map("assigned_to")
  createdById         String?    @map("created_by")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// All three composite FKs below use Restrict, not SetNull — a composite
  /// FK can't null a required workspace_id column (same reasoning as
  /// Availability.guide). Company/Customer are never hard-deleted (soft-
  /// delete only); a WorkspaceMember removal explicitly clears
  /// `assignedToId` first (see lib/crm/leads.ts `clearCrmAssignments`,
  /// called from the member-removal route), so Restrict never blocks it.
  company           Company?         @relation(fields: [workspaceId, companyId], references: [workspaceId, id], onDelete: Restrict)
  convertedCustomer Customer?        @relation(fields: [workspaceId, convertedCustomerId], references: [workspaceId, id], onDelete: Restrict)
  assignedTo        WorkspaceMember? @relation(fields: [workspaceId, assignedToId], references: [workspaceId, id], onDelete: Restrict)
  createdBy         User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tasks             CrmTask[]
  activities        CrmActivity[]
  itineraries       Itinerary[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@index([workspaceId, companyId])
  @@map("leads")
}

/// Follow-up task, optionally linked to one Customer or one Lead (never
/// both — enforced by a CHECK constraint in migration SQL, same pattern as
/// availabilities' hand-written capacity constraints). A task linked to
/// neither is a general workspace to-do.
model CrmTask {
  id           String        @id @default(cuid())
  workspaceId  String        @map("workspace_id")
  title        String
  description  String?
  dueAt        DateTime?     @map("due_at") @db.Timestamptz(6)
  status       CrmTaskStatus @default(open)
  completedAt  DateTime?     @map("completed_at") @db.Timestamptz(6)
  customerId   String?       @map("customer_id")
  leadId       String?       @map("lead_id")
  assignedToId String?       @map("assigned_to")
  createdById  String?       @map("created_by")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer   Customer?        @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Cascade)
  lead       Lead?            @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Cascade)
  /// Restrict, not SetNull — see the matching comment on Lead.assignedTo.
  assignedTo WorkspaceMember? @relation(fields: [workspaceId, assignedToId], references: [workspaceId, id], onDelete: Restrict)
  createdBy  User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, id])
  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, customerId])
  @@index([workspaceId, leadId])
  @@index([workspaceId, assignedToId])
  @@map("crm_tasks")
}

/// Append-only interaction timeline — one row per logged touchpoint
/// (call, email, WhatsApp, SMS, meeting, note, or an automatic
/// `status_change` entry). Linked to exactly one of Customer or Lead
/// (CHECK constraint, same reasoning as CrmTask). This is the backbone of
/// the "Customer Timeline" — bookings/payments render alongside it in the
/// UI from their own tables rather than being duplicated here.
model CrmActivity {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  customerId  String?         @map("customer_id")
  leadId      String?         @map("lead_id")
  type        CrmActivityType @default(note)
  subject     String?
  body        String?
  occurredAt  DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)
  createdById String?         @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, customerId, occurredAt])
  @@index([workspaceId, leadId, occurredAt])
  @@map("crm_activities")
}

model WaiverSignature {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  bookingId       String   @map("booking_id")
  participantId   String   @map("participant_id")
  waiverVersionId String   @map("waiver_version_id")
  signerName      String   @map("signer_name")
  signatureImage  String   @map("signature_image")
  signedAt        DateTime @map("signed_at") @db.Timestamptz(6)
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  booking       Booking            @relation(fields: [workspaceId, bookingId], references: [workspaceId, id], onDelete: Restrict)
  participant   BookingParticipant @relation(fields: [workspaceId, participantId], references: [workspaceId, id], onDelete: Restrict)
  waiverVersion WaiverVersion      @relation(fields: [workspaceId, waiverVersionId], references: [workspaceId, id], onDelete: Restrict)

  @@unique([workspaceId, participantId])
  @@index([workspaceId, bookingId])
  @@map("waiver_signatures")
}

/**
 * ------------------------------------------------------------------------
 */
/**
 * Phase 6 (extended) — Workforce management: drivers, time off, hours, ratings
 * New enums are declared next to the models that use them (rather than the
 * top-of-file block Phases 1-6 originally used) so each phase stays a
 * self-contained, reviewable unit — Prisma does not care about declaration
 * order.
 */
/**
 * ------------------------------------------------------------------------
 */

enum GuideKind {
  guide
  driver
  both

  @@map("guide_kind")
}

enum StaffEmploymentType {
  employee
  freelancer
  contractor

  @@map("staff_employment_type")
}

enum TimeOffStatus {
  requested
  approved
  declined

  @@map("time_off_status")
}

/// Vacation / unavailability window for a workforce member. Distinct from
/// simply having no assignments — an approved row here is a hard exclusion
/// signal for AI guide/driver matching (lib/workforce/matching.ts).
model StaffTimeOff {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  memberId    String        @map("member_id")
  startsOn    DateTime      @map("starts_on") @db.Date
  endsOn      DateTime      @map("ends_on") @db.Date
  reason      String?
  status      TimeOffStatus @default(requested)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember @relation(fields: [workspaceId, memberId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, memberId, startsOn])
  @@map("staff_time_off")
}

/// Operator-logged hours worked on a specific date, optionally tied to the
/// departure it was worked on — feeds "Payroll Hours" and the overtime
/// signal in AI guide/driver matching. Not a time-clock/punch system: hours
/// are entered after the fact by an owner/admin.
model StaffTimeEntry {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  memberId       String   @map("member_id")
  availabilityId String?  @map("availability_id")
  workedOn       DateTime @map("worked_on") @db.Date
  minutes        Int
  role           String?
  note           String?
  createdById    String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member       WorkspaceMember @relation(fields: [workspaceId, memberId], references: [workspaceId, id], onDelete: Cascade)
  availability Availability?   @relation(fields: [workspaceId, availabilityId], references: [workspaceId, id], onDelete: Restrict)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, memberId, workedOn])
  @@index([workspaceId, availabilityId])
  @@map("staff_time_entries")
}

/// Operator-recorded performance rating for a member, optionally tied to a
/// specific departure. `ratingValue` 1-5, enforced by a CHECK constraint in
/// migration SQL (same pattern as availabilities' capacity constraints).
/// Feeds the Guide Dashboard's average rating and the AI matching score.
model GuideRating {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  memberId       String   @map("member_id")
  availabilityId String?  @map("availability_id")
  ratingValue    Int      @map("rating_value")
  comment        String?
  createdById    String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member       WorkspaceMember @relation(fields: [workspaceId, memberId], references: [workspaceId, id], onDelete: Cascade)
  availability Availability?   @relation(fields: [workspaceId, availabilityId], references: [workspaceId, id], onDelete: Restrict)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, memberId])
  @@index([workspaceId, availabilityId])
  @@map("guide_ratings")
}

/**
 * ------------------------------------------------------------------------
 */
/**
 * Phase 7 — Vehicle management
 */
/**
 * ------------------------------------------------------------------------
 */

enum VehicleType {
  car
  van
  minibus
  bus
  boat
  other

  @@map("vehicle_type")
}

enum VehicleStatus {
  active
  maintenance
  retired

  @@map("vehicle_status")
}

enum MaintenanceType {
  service
  repair
  inspection

  @@map("maintenance_type")
}

model Vehicle {
  id                    String        @id @default(cuid())
  workspaceId           String        @map("workspace_id")
  name                  String
  type                  VehicleType   @default(car)
  licensePlate          String?       @map("license_plate")
  capacity              Int
  status                VehicleStatus @default(active)
  odometer              Int?
  fuelType              String?       @map("fuel_type")
  insuranceExpiresOn    DateTime?     @map("insurance_expires_on") @db.Date
  registrationExpiresOn DateTime?     @map("registration_expires_on") @db.Date
  notes                 String?
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?     @map("deleted_at") @db.Timestamptz(6)

  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  availabilities     Availability[]
  maintenanceRecords VehicleMaintenanceRecord[]
  fuelLogs           VehicleFuelLog[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@map("vehicles")
}

model VehicleMaintenanceRecord {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  vehicleId   String          @map("vehicle_id")
  type        MaintenanceType @default(service)
  performedOn DateTime        @map("performed_on") @db.Date
  odometer    Int?
  costCents   Int?            @map("cost_cents")
  vendorName  String?         @map("vendor_name")
  notes       String?
  nextDueOn   DateTime?       @map("next_due_on") @db.Date
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [workspaceId, vehicleId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, vehicleId, performedOn])
  @@map("vehicle_maintenance_records")
}

/// One row per fuel purchase — cost + odometer only (no volume/unit
/// tracking) is enough to derive "Fuel Cost" and mileage-since-last-fill
/// without adding a unit-of-measure dimension the rest of the app doesn't
/// need yet.
model VehicleFuelLog {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  vehicleId   String   @map("vehicle_id")
  loggedOn    DateTime @map("logged_on") @db.Date
  costCents   Int      @map("cost_cents")
  odometer    Int?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [workspaceId, vehicleId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, vehicleId, loggedOn])
  @@map("vehicle_fuel_logs")
}

/**
 * ------------------------------------------------------------------------
 */
/**
 * Phase 8/9 — Operations Center & Dispatch Center
 * Share one migration/model group: both read and write the same live-status
 * surface on Availability/Booking, so splitting them would only duplicate
 * the same columns under two names.
 */
/**
 * ------------------------------------------------------------------------
 */

enum OpsStatus {
  scheduled
  boarding
  in_progress
  delayed
  completed
  cancelled

  @@map("ops_status")
}

enum OpsEventType {
  status_changed
  note
  delay_reported
  checkin
  incident_reported
  route_changed
  customer_notified

  @@map("ops_event_type")
}

enum IncidentSeverity {
  low
  medium
  high
  critical

  @@map("incident_severity")
}

enum IncidentCategory {
  medical
  vehicle
  weather
  guest_behavior
  other

  @@map("incident_category")
}

enum IncidentStatus {
  open
  investigating
  resolved

  @@map("incident_status")
}

/// Append-only operations timeline for a departure — status transitions,
/// delay reports, check-ins, route changes, and internal notes all land
/// here as one feed (mirrors BookingStatusEvent's append-only pattern).
model OpsEvent {
  id             String       @id @default(cuid())
  workspaceId    String       @map("workspace_id")
  availabilityId String       @map("availability_id")
  type           OpsEventType
  fromStatus     OpsStatus?   @map("from_status")
  toStatus       OpsStatus?   @map("to_status")
  message        String?
  actorUserId    String?      @map("actor_user_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  availability Availability @relation(fields: [workspaceId, availabilityId], references: [workspaceId, id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, availabilityId, createdAt])
  @@map("ops_events")
}

/// Dispatch Center incident log. `availabilityId` is nullable — some
/// incidents (a vehicle breakdown discovered in the yard) aren't tied to a
/// specific departure.
model IncidentReport {
  id              String           @id @default(cuid())
  workspaceId     String           @map("workspace_id")
  availabilityId  String?          @map("availability_id")
  severity        IncidentSeverity @default(medium)
  category        IncidentCategory @default(other)
  status          IncidentStatus   @default(open)
  description     String
  resolutionNotes String?          @map("resolution_notes")
  resolvedAt      DateTime?        @map("resolved_at") @db.Timestamptz(6)
  reportedById    String?          @map("reported_by")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  availability Availability? @relation(fields: [workspaceId, availabilityId], references: [workspaceId, id], onDelete: Restrict)
  reportedBy   User?         @relation(fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, availabilityId])
  @@map("incident_reports")
}

/**
 * ------------------------------------------------------------------------
 */
/**
 * Phase 10 — Vendor management
 */
/**
 * ------------------------------------------------------------------------
 */

enum VendorKind {
  hotel
  restaurant
  transport
  activity_provider
  other

  @@map("vendor_kind")
}

enum VendorInvoiceStatus {
  unpaid
  paid
  overdue
  cancelled

  @@map("vendor_invoice_status")
}

model Vendor {
  id                String     @id @default(cuid())
  workspaceId       String     @map("workspace_id")
  name              String
  kind              VendorKind @default(other)
  contactName       String?    @map("contact_name")
  email             String?
  phone             String?
  country           String?
  commissionRateBps Int?       @map("commission_rate_bps")
  /// 1-5, enforced by a CHECK constraint in migration SQL.
  rating            Int?
  isActive          Boolean    @default(true) @map("is_active")
  notes             String?
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices       VendorInvoice[]
  itineraryItems ItineraryItem[]

  @@unique([workspaceId, id])
  @@index([workspaceId, kind])
  @@map("vendors")
}

model VendorInvoice {
  id            String              @id @default(cuid())
  workspaceId   String              @map("workspace_id")
  vendorId      String              @map("vendor_id")
  invoiceNumber String?             @map("invoice_number")
  amountCents   Int                 @map("amount_cents")
  currency      String              @default("USD")
  issuedOn      DateTime            @map("issued_on") @db.Date
  dueOn         DateTime?           @map("due_on") @db.Date
  status        VendorInvoiceStatus @default(unpaid)
  paidAt        DateTime?           @map("paid_at") @db.Timestamptz(6)
  notes         String?
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vendor    Vendor    @relation(fields: [workspaceId, vendorId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, vendorId])
  @@index([workspaceId, status, dueOn])
  @@map("vendor_invoices")
}

/**
 * ------------------------------------------------------------------------
 */
/**
 * Phase 11 — AI Itinerary Builder
 */
/**
 * ------------------------------------------------------------------------
 */

enum ItineraryStatus {
  draft
  shared
  confirmed
  archived

  @@map("itinerary_status")
}

enum ItineraryItemType {
  accommodation
  meal
  activity
  transfer
  flight
  guide
  vehicle
  other

  @@map("itinerary_item_type")
}

/// A multi-day proposal, generated from the workspace's own tour/vendor
/// inventory (lib/itinerary/generator.ts) and then freely editable.
/// `publicToken` powers the customer-facing share link, same pattern as
/// Booking.publicToken.
model Itinerary {
  id            String          @id @default(cuid())
  workspaceId   String          @map("workspace_id")
  title         String
  destination   String?
  dayCount      Int             @map("day_count")
  startDate     DateTime?       @map("start_date") @db.Date
  travelerCount Int?            @map("traveler_count")
  currency      String          @default("USD")
  status        ItineraryStatus @default(draft)
  customerId    String?         @map("customer_id")
  leadId        String?         @map("lead_id")
  publicToken   String          @unique @map("public_token")
  createdById   String?         @map("created_by")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Restrict, not SetNull — composite FK, same reasoning as Lead.company.
  customer  Customer?          @relation(fields: [workspaceId, customerId], references: [workspaceId, id], onDelete: Restrict)
  lead      Lead?              @relation(fields: [workspaceId, leadId], references: [workspaceId, id], onDelete: Restrict)
  createdBy User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  days      ItineraryDay[]
  items     ItineraryItem[]
  versions  ItineraryVersion[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@index([workspaceId, customerId])
  @@index([workspaceId, leadId])
  @@map("itineraries")
}

model ItineraryDay {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  itineraryId String    @map("itinerary_id")
  dayNumber   Int       @map("day_number")
  date        DateTime? @db.Date
  title       String?
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  itinerary Itinerary       @relation(fields: [workspaceId, itineraryId], references: [workspaceId, id], onDelete: Cascade)
  items     ItineraryItem[]

  @@unique([workspaceId, itineraryId, dayNumber])
  @@unique([workspaceId, id])
  @@index([workspaceId, itineraryId])
  @@map("itinerary_days")
}

/// One line item on one day. `tourId`/`vendorId` are optional provenance
/// links back to the workspace's own catalog when the generator (or an
/// operator) sourced this item from an existing Tour or Vendor —
/// `costCents`/`priceCents` are always independent snapshot values so
/// margin stays correct even if the source tour/vendor is later edited.
model ItineraryItem {
  id             String            @id @default(cuid())
  workspaceId    String            @map("workspace_id")
  itineraryId    String            @map("itinerary_id")
  itineraryDayId String            @map("itinerary_day_id")
  type           ItineraryItemType @default(other)
  title          String
  description    String?
  startTime      String?           @map("start_time")
  tourId         String?           @map("tour_id")
  vendorId       String?           @map("vendor_id")
  costCents      Int               @default(0) @map("cost_cents")
  priceCents     Int               @default(0) @map("price_cents")
  sortOrder      Int               @default(0) @map("sort_order")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  itinerary Itinerary    @relation(fields: [workspaceId, itineraryId], references: [workspaceId, id], onDelete: Cascade)
  day       ItineraryDay @relation(fields: [workspaceId, itineraryDayId], references: [workspaceId, id], onDelete: Cascade)
  tour      Tour?        @relation(fields: [workspaceId, tourId], references: [workspaceId, id], onDelete: Restrict)
  vendor    Vendor?      @relation(fields: [workspaceId, vendorId], references: [workspaceId, id], onDelete: Restrict)

  @@index([workspaceId, itineraryId, sortOrder])
  @@index([workspaceId, itineraryDayId])
  @@map("itinerary_items")
}

/// Immutable snapshot taken on every save-worthy edit — "Version History".
/// Same immutable-versioning pattern as WaiverVersion: never updated or
/// deleted, just accumulated.
model ItineraryVersion {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  itineraryId   String   @map("itinerary_id")
  versionNumber Int      @map("version_number")
  snapshot      Json
  note          String?
  createdById   String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  itinerary Itinerary @relation(fields: [workspaceId, itineraryId], references: [workspaceId, id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, itineraryId, versionNumber])
  @@map("itinerary_versions")
}

