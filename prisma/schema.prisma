/// Delivery outcome for a marketing lead. Persistence is never conditional on
/// delivery: the row is written first and this records what happened to the
/// notification afterwards, so a missing SMTP configuration loses a
/// notification rather than a lead.
enum LeadDeliveryStatus {
  pending
  sent
  failed
  skipped

  @@map("lead_delivery_status")
}

enum NewsletterSubscriberStatus {
  pending_confirmation
  subscribed
  unsubscribed

  @@map("newsletter_subscriber_status")
}

/// A public contact-form enquiry. Not tenant-scoped: these arrive before a
/// workspace exists, so they belong to the platform rather than to a customer.
///
/// Client metadata is stored as a salted digest rather than raw values. The
/// operational need is "are these fifty submissions the same origin", which a
/// digest answers, without retaining an identifier subject to erasure requests.
model MarketingContactSubmission {
  id              String             @id @default(cuid())
  name            String
  email           String
  emailNormalized String             @map("email_normalized")
  company         String?
  reason          String
  message         String
  source          String?
  consentAt       DateTime           @map("consent_at") @db.Timestamptz(6)
  clientHash      String?            @map("client_hash")
  userAgentHash   String?            @map("user_agent_hash")
  deliveryStatus  LeadDeliveryStatus @default(pending) @map("delivery_status")
  deliveryError   String?            @map("delivery_error")
  deliveredAt     DateTime?          @map("delivered_at") @db.Timestamptz(6)
  handledAt       DateTime?          @map("handled_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([deliveryStatus, createdAt])
  @@index([emailNormalized])
  @@map("marketing_contact_submissions")
}

/// A newsletter subscriber. `emailNormalized` is unique so a repeat signup is
/// an idempotent no-op rather than a duplicate or an error — re-subscribing
/// must not reveal whether an address was already on the list.
model NewsletterSubscriber {
  id              String                     @id @default(cuid())
  email           String
  emailNormalized String                     @unique @map("email_normalized")
  status          NewsletterSubscriberStatus @default(pending_confirmation)
  source          String?
  consentAt       DateTime                   @map("consent_at") @db.Timestamptz(6)
  confirmedAt     DateTime?                  @map("confirmed_at") @db.Timestamptz(6)
  unsubscribedAt  DateTime?                  @map("unsubscribed_at") @db.Timestamptz(6)
  clientHash      String?                    @map("client_hash")
  userAgentHash   String?                    @map("user_agent_hash")
  deliveryStatus  LeadDeliveryStatus         @default(pending) @map("delivery_status")
  deliveryError   String?                    @map("delivery_error")
  deliveredAt     DateTime?                  @map("delivered_at") @db.Timestamptz(6)
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("newsletter_subscribers")
}

enum JobRunStatus {
  running
  succeeded
  failed
  /// Another instance held the advisory lock; this tick did no work. Distinct
  /// from `succeeded` so "the job is running fine" and "every tick is being
  /// skipped because a lock leaked" cannot look identical in the history.
  skipped

  @@map("job_run_status")
}

/// Execution history for scheduled jobs.
///
/// Exists so a scheduler is observable rather than a black box: which jobs
/// ran, when, how long they took, what they touched, and what failed. The
/// admin health page reads real values from here instead of the hard-coded
/// "ready" badges it displayed before.
///
/// Concurrency is handled by a PostgreSQL advisory lock rather than by a row
/// in this table — see `lib/jobs/runner.ts`. A lock held for the duration of
/// the transaction is released automatically if the worker dies, whereas a
/// status row would strand the job as permanently "running".
model JobRun {
  id          String       @id @default(cuid())
  jobName     String       @map("job_name")
  status      JobRunStatus @default(running)
  startedAt   DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime?    @map("finished_at") @db.Timestamptz(6)
  durationMs  Int?         @map("duration_ms")
  /// Job-specific counters (scanned/processed/skipped). Never PII.
  result      Json         @default("{}")
  error       String?
  /// Set when a run was skipped because another instance held the lock.
  lockSkipped Boolean      @default(false) @map("lock_skipped")
  triggeredBy String       @default("schedule") @map("triggered_by")

  @@index([jobName, startedAt])
  @@index([status, startedAt])
  @@map("job_runs")
}

/**
 * ------------------------------------------------------------------------
 */
/**
 * Phase 7 — account verification, password reset, rate limiting
 */
/**
 * ------------------------------------------------------------------------
 */

enum AuthTokenPurpose {
  email_verification
  password_reset

  @@map("auth_token_purpose")
}

/// Single-use, short-lived token for email verification and password reset.
///
/// The token is stored as a SHA-256 digest, never in plaintext — unlike
/// `Invitation.token`, which audit §7 flags precisely because a leaked
/// backup hands an attacker working invitation links. A digest means a
/// database dump is useless for authentication: the secret only ever exists
/// in the email that was sent and in the URL the user clicks.
///
/// Rows are kept after consumption rather than deleted, so "this reset link
/// was already used" is answerable and the audit trail survives.
model AuthToken {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  purpose    AuthTokenPurpose
  /// SHA-256 of the token. Unique, so presenting a token is a single indexed
  /// lookup and a collision cannot silently authenticate the wrong account.
  tokenHash  String           @unique @map("token_hash")
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(6)
  /// Recorded for the audit trail. Never used to authorise anything.
  requestIp  String?          @map("request_ip")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "Newest live token for this user and purpose" — the issue path checks
  /// this to avoid emailing a fresh link on every button press.
  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("auth_tokens")
}

/// Fixed-window rate limit counter, shared across application instances.
///
/// Deliberately in PostgreSQL rather than in process memory. The in-process
/// limiter this replaces (lib/marketing/rate-limit.ts) gave every container
/// its own budget and reset on restart, so the real limit was
/// `limit x instances` and an attacker could reset it by causing a deploy.
/// For login, registration and password reset that is not a limit at all.
///
/// A row per (key, window) with an upsert-and-increment is one round trip on
/// endpoints that are low-volume by nature. Redis would be faster and is the
/// right answer at a different scale; correctness across instances matters
/// more here than the microseconds.
model RateLimitCounter {
  /// `<bucket>:<subject>:<windowStartEpochMs>` — the window is part of the
  /// key so expiry is a delete of old rows rather than a read-modify-write.
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("rate_limit_counters")
}

// ===========================================================================
// V3 — Cloudflare platform expansion
// ===========================================================================

/// Replay protection for signed service-to-service requests.
///
/// `lib/cloudflare/signatures.ts` proves a request is authentic, unmodified
/// and recent. Recent is not the same as unrepeated: anything that captures a
/// request inside the skew window can send it again. For a read that is
/// merely wasteful; for `publishSite` or an x402 settlement it is a duplicate
/// side effect.
///
/// The nonce is the primary key, so the insert itself is the check — a unique
/// violation *is* the replay detection, with no read-then-write race between
/// two concurrent copies of the same request.
model ServiceRequestNonce {
  nonce     String   @id
  /// Namespaces nonces by caller, so an unlucky collision between two
  /// independent services cannot reject a legitimate request.
  purpose   String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("service_request_nonces")
}

enum SiteStatus {
  draft
  generating
  ready
  publishing
  published
  failed
  suspended
}

enum SiteDeploymentStatus {
  queued
  building
  deploying
  live
  failed
  rolled_back
}

/// A tenant website built with the Site Builder and served from Workers for
/// Platforms.
///
/// Distinct from `WorkspaceStorefront`, which is the fixed-shape v2 booking
/// storefront and stays exactly as it is. A workspace can run both: the
/// storefront answers on `/book/<slug>` regardless, and a published Site takes
/// over the subdomain and any bound custom domain.
model Site {
  id                  String     @id @default(cuid())
  workspaceId         String     @map("workspace_id")
  name                String
  /// URL-safe identity inside the workspace.
  slug                String
  status              SiteStatus @default(draft)
  templateKey         String     @map("template_key")
  /// Label of the Tripistic-owned hostname: `<subdomain>.tripistic.site`.
  /// Globally unique because it is a hostname, not a per-tenant name.
  subdomain           String     @unique
  homePageId          String?    @map("home_page_id")
  publishedRevisionId String?    @map("published_revision_id")
  draftRevisionId     String?    @map("draft_revision_id")
  /// Brand tokens (colours, fonts, radii) as a validated JSON blob. Schema
  /// lives in lib/sites/schema.ts, not in the database, so a template can add
  /// a token without a migration.
  theme               Json       @default("{}")
  /// Site-wide SEO defaults; per-page values override these.
  seo                 Json       @default("{}")
  navigation          Json       @default("{}")
  createdById         String?    @map("created_by")
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt         DateTime?  @map("published_at") @db.Timestamptz(6)
  deletedAt           DateTime?  @map("deleted_at") @db.Timestamptz(6)

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?            @relation("SiteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  pages       SitePage[]
  revisions   SiteRevision[]
  deployments SiteDeployment[]
  domains     CustomDomain[]

  @@unique([workspaceId, slug])
  /// Composite unique so child rows can carry `workspaceId` and reference the
  /// site through it — the same tenant-safe foreign key pattern the booking
  /// subtree already uses. A child row physically cannot point at another
  /// tenant's site.
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@map("sites")
}

/// One page of a site. Content is a structured section array, never raw HTML.
model SitePage {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  siteId      String   @map("site_id")
  /// Leading-slash path: `/`, `/tours`, `/about`.
  path        String
  title       String
  /// `{ version: 1, sections: [{ type, props }] }`, validated by Zod on
  /// every write. Storing arbitrary HTML here would make every tenant page a
  /// stored-XSS vector against every other visitor on that hostname.
  content     Json     @default("{}")
  seo         Json     @default("{}")
  enabled     Boolean  @default(true)
  position    Int      @default(0)
  /// Set for pages the template owns (`/tours/[slug]`), which the operator
  /// may edit but not delete.
  systemKey   String?  @map("system_key")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  site      Site      @relation(fields: [workspaceId, siteId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([siteId, path])
  @@index([workspaceId, siteId, position])
  @@map("site_pages")
}

/// An immutable snapshot of a whole site, taken on publish.
///
/// The published revision — not the live `SitePage` rows — is what gets
/// rendered into a Worker bundle. That separation is what makes rollback a
/// real operation rather than an apology: editing a draft can never change
/// what visitors are currently being served.
model SiteRevision {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  siteId        String   @map("site_id")
  versionNumber Int      @map("version_number")
  /// Full site + pages snapshot.
  snapshot      Json
  /// SHA-256 of the rendered bundle, so an unchanged publish is detectable.
  checksum      String
  note          String?
  createdById   String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  site        Site             @relation(fields: [workspaceId, siteId], references: [workspaceId, id], onDelete: Cascade)
  createdBy   User?            @relation("SiteRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deployments SiteDeployment[]

  @@unique([siteId, versionNumber])
  @@index([workspaceId, createdAt])
  @@map("site_revisions")
}

/// One attempt to put a revision live on the edge.
model SiteDeployment {
  id            String               @id @default(cuid())
  workspaceId   String               @map("workspace_id")
  siteId        String               @map("site_id")
  revisionId    String               @map("revision_id")
  status        SiteDeploymentStatus @default(queued)
  environment   String               @default("production")
  /// Dispatch-namespace script name. Derived server-side; see
  /// lib/cloudflare/workers-platform.ts::siteScriptName.
  scriptName    String?              @map("script_name")
  previewUrl    String?              @map("preview_url")
  liveUrl       String?              @map("live_url")
  /// Populated only on failure, and only with a message safe to show an
  /// operator — never a provider token or a stack trace.
  errorMessage  String?              @map("error_message")
  healthCheckAt DateTime?            @map("health_check_at") @db.Timestamptz(6)
  startedAt     DateTime?            @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime?            @map("finished_at") @db.Timestamptz(6)
  triggeredById String?              @map("triggered_by")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  site        Site         @relation(fields: [workspaceId, siteId], references: [workspaceId, id], onDelete: Cascade)
  revision    SiteRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  triggeredBy User?        @relation("SiteDeploymentTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  @@index([workspaceId, siteId, createdAt])
  @@index([status, createdAt])
  @@map("site_deployments")
}

/// Retrieval scope of a knowledge document. Mirrors the `visibility` metadata
/// written onto every vector, and the two must not diverge — see
/// lib/ai/rag/indexer.ts.
enum KnowledgeScope {
  /// Tripistic's own product documentation. Readable by every surface.
  global
  /// Curated public travel content. Readable by the public advisor.
  public
  /// Tenant-owned. Readable only with the owning workspace's filter.
  private
}

enum KnowledgeIndexStatus {
  pending
  indexing
  indexed
  failed
  stale
}

/// A thing that produces knowledge documents: an uploaded file, a tour
/// record, a business profile, a URL.
model KnowledgeSource {
  id          String               @id @default(cuid())
  /// Null for `global` and `public` scopes, which no workspace owns.
  workspaceId String?              @map("workspace_id")
  scope       KnowledgeScope
  sourceType  String               @map("source_type")
  /// Id of the originating record when there is one (a tour, a page).
  sourceId    String?              @map("source_id")
  title       String
  status      KnowledgeIndexStatus @default(pending)
  /// Content hash. Re-indexing is skipped when it has not moved, which is the
  /// difference between an embedding bill that tracks edits and one that
  /// tracks cron ticks.
  checksum    String?
  language    String               @default("en")
  version     Int                  @default(1)
  metadata    Json                 @default("{}")
  indexedAt   DateTime?            @map("indexed_at") @db.Timestamptz(6)
  createdById String?              @map("created_by")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?               @relation("KnowledgeSourceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents KnowledgeDocument[]
  indexJobs KnowledgeIndexJob[]

  @@unique([scope, sourceType, sourceId])
  @@index([workspaceId, scope, status])
  @@map("knowledge_sources")
}

/// Normalised text extracted from a source, ready to chunk and embed.
model KnowledgeDocument {
  id          String               @id @default(cuid())
  workspaceId String?              @map("workspace_id")
  sourceId    String               @map("source_id")
  scope       KnowledgeScope
  title       String
  /// Extracted plain text. Kept so a reindex does not have to re-fetch or
  /// re-parse the original, and so a retrieved chunk can be shown in context.
  body        String
  checksum    String
  language    String               @default("en")
  version     Int                  @default(1)
  status      KnowledgeIndexStatus @default(pending)
  chunkCount  Int                  @default(0) @map("chunk_count")
  indexedAt   DateTime?            @map("indexed_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    KnowledgeSource     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks    KnowledgeChunkRef[]

  @@index([workspaceId, scope, status])
  @@index([sourceId, version])
  @@map("knowledge_documents")
}

/// Pointer to a vector that exists in Vectorize.
///
/// The embedding itself is deliberately *not* duplicated here — it is large,
/// it is derived, and PostgreSQL is not where it is queried. What is stored is
/// the id, so deletion is exact: when a document goes away, this table says
/// precisely which vectors must go with it. Without it, cleanup would be a
/// prefix scan against a store that does not offer one, and orphaned private
/// vectors would stay retrievable after the tenant deleted the source.
model KnowledgeChunkRef {
  id          String   @id @default(cuid())
  workspaceId String?  @map("workspace_id")
  documentId  String   @map("document_id")
  chunkIndex  Int      @map("chunk_index")
  vectorId    String   @unique @map("vector_id")
  /// First ~200 characters, for showing a source reference without a second
  /// round trip. Never used as the retrieved content itself.
  preview     String
  tokenCount  Int      @default(0) @map("token_count")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document  KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([workspaceId])
  @@map("knowledge_chunk_refs")
}

model KnowledgeIndexJob {
  id          String               @id @default(cuid())
  workspaceId String?              @map("workspace_id")
  sourceId    String               @map("source_id")
  status      KnowledgeIndexStatus @default(pending)
  attempts    Int                  @default(0)
  lastError   String?              @map("last_error")
  startedAt   DateTime?            @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime?            @map("finished_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([workspaceId, status])
  @@map("knowledge_index_jobs")
}

enum AiSurface {
  /// Public travel advisor on tripistic.com. Anonymous callers allowed.
  public_advisor
  /// Workspace copilot in the dashboard. Always authenticated.
  workspace_copilot
  /// Contextual assistant embedded in a dashboard module.
  contextual
  /// Non-conversational generation (site copy, SEO), still metered.
  system
}

model AiConversation {
  id          String    @id @default(cuid())
  /// Null for anonymous public-advisor conversations.
  workspaceId String?   @map("workspace_id")
  userId      String?   @map("user_id")
  surface     AiSurface
  title       String?
  /// Opaque, high-entropy handle for an anonymous public session. Lets a
  /// visitor keep their thread without an account, and lets them convert it to
  /// one later. Unique so it cannot be guessed into another visitor's thread.
  publicToken String?   @unique @map("public_token")
  /// Rolling summary of older turns. Full history is never resent to the
  /// model; recent turns plus this is what goes in the context window.
  summary     String?
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace?              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?                   @relation("AiConversationUser", fields: [userId], references: [id], onDelete: SetNull)
  messages  AiConversationMessage[]

  @@index([workspaceId, updatedAt])
  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiConversationMessage {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  /// Position within the thread, 1-based.
  ///
  /// Not derivable from `createdAt`: a user turn and the assistant turn that
  /// answers it are written in one transaction, and PostgreSQL's `now()` is
  /// transaction time — so both rows carry an identical timestamp and ordering
  /// by it puts the answer before the question about half the time. An explicit
  /// counter is the only ordering that survives that, and the unique index
  /// makes a duplicate position an error rather than a silently scrambled
  /// history.
  sequence       Int
  /// `user` | `assistant` | `tool`. Not an enum: the set tracks whatever the
  /// provider protocol supports and should not need a migration to widen.
  role           String
  content        String
  /// Tool calls and their results, when the turn made any.
  toolCalls      Json     @default("[]") @map("tool_calls")
  /// Retrieved chunk references backing this answer, for source display and
  /// for after-the-fact review of what the model was actually shown.
  citations      Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@index([conversationId, createdAt])
  @@map("ai_conversation_messages")
}

/// One model call. The unit both metering and cost attribution are built on.
model AiUsageEvent {
  id            String    @id @default(cuid())
  workspaceId   String?   @map("workspace_id")
  userId        String?   @map("user_id")
  surface       AiSurface
  task          String
  provider      String
  model         String
  inputTokens   Int       @default(0) @map("input_tokens")
  outputTokens  Int       @default(0) @map("output_tokens")
  /// Millicents. Integer arithmetic, because a per-call cost of $0.0003 in a
  /// float accumulates a visible error over a month of billing.
  estimatedCost Int       @default(0) @map("estimated_cost_millicents")
  latencyMs     Int       @default(0) @map("latency_ms")
  success       Boolean   @default(true)
  errorType     String?   @map("error_type")
  requestId     String?   @map("request_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([surface, createdAt])
  @@map("ai_usage_events")
}

enum X402PaymentStatus {
  pending
  verified
  rejected
  expired
}

/// An x402 machine payment for a protected API route.
///
/// Entirely separate from `Payment`, which is a traveler paying for a booking
/// through Stripe. Conflating them would put an experimental settlement rail
/// in the path of the revenue that actually pays the bills; the V3 brief
/// forbids it and the schema keeps them apart.
model X402Payment {
  id                   String            @id @default(cuid())
  /// Null when the caller is an unaffiliated agent rather than a workspace.
  workspaceId          String?           @map("workspace_id")
  requestId            String            @unique @map("request_id")
  route                String
  amount               String
  currency             String
  network              String
  payer                String?
  /// On-chain or facilitator reference. Unique, because the same settlement
  /// must never be credited twice — this constraint is the replay defence,
  /// not a convention.
  transactionReference String?           @unique @map("transaction_reference")
  status               X402PaymentStatus @default(pending)
  verifiedAt           DateTime?         @map("verified_at") @db.Timestamptz(6)
  accessExpiresAt      DateTime?         @map("access_expires_at") @db.Timestamptz(6)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  grants    X402AccessGrant[]

  @@index([status, createdAt])
  @@index([workspaceId, createdAt])
  @@map("x402_payments")
}

/// Time-boxed access to a protected route, bought by a verified payment.
model X402AccessGrant {
  id          String   @id @default(cuid())
  workspaceId String?  @map("workspace_id")
  paymentId   String   @map("payment_id")
  route       String
  /// SHA-256 of the bearer token handed back to the caller. The token itself
  /// is never stored: a leaked grants table must not be a set of working
  /// credentials.
  tokenHash   String   @unique @map("token_hash")
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  usedCount   Int      @default(0) @map("used_count")
  maxUses     Int      @default(0) @map("max_uses")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  payment   X402Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("x402_access_grants")
}
