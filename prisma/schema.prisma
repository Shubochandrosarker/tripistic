enum VehicleType {
  car
  van
  minibus
  bus
  boat
  other

  @@map("vehicle_type")
}

enum VehicleStatus {
  active
  maintenance
  retired

  @@map("vehicle_status")
}

enum MaintenanceType {
  service
  repair
  inspection

  @@map("maintenance_type")
}

model Vehicle {
  id                    String        @id @default(cuid())
  workspaceId           String        @map("workspace_id")
  name                  String
  type                  VehicleType   @default(car)
  licensePlate          String?       @map("license_plate")
  capacity              Int
  status                VehicleStatus @default(active)
  odometer              Int?
  fuelType              String?       @map("fuel_type")
  insuranceExpiresOn    DateTime?     @map("insurance_expires_on") @db.Date
  registrationExpiresOn DateTime?     @map("registration_expires_on") @db.Date
  notes                 String?
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?     @map("deleted_at") @db.Timestamptz(6)

  workspace          Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  availabilities     Availability[]
  maintenanceRecords VehicleMaintenanceRecord[]
  fuelLogs           VehicleFuelLog[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@map("vehicles")
}

model VehicleMaintenanceRecord {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  vehicleId   String          @map("vehicle_id")
  type        MaintenanceType @default(service)
  performedOn DateTime        @map("performed_on") @db.Date
  odometer    Int?
  costCents   Int?            @map("cost_cents")
  vendorName  String?         @map("vendor_name")
  notes       String?
  nextDueOn   DateTime?       @map("next_due_on") @db.Date
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [workspaceId, vehicleId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, vehicleId, performedOn])
  @@map("vehicle_maintenance_records")
}

/// One row per fuel purchase — cost + odometer only (no volume/unit
/// tracking) is enough to derive "Fuel Cost" and mileage-since-last-fill
/// without adding a unit-of-measure dimension the rest of the app doesn't
/// need yet.
model VehicleFuelLog {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  vehicleId   String   @map("vehicle_id")
  loggedOn    DateTime @map("logged_on") @db.Date
  costCents   Int      @map("cost_cents")
  odometer    Int?
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [workspaceId, vehicleId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, vehicleId, loggedOn])
  @@map("vehicle_fuel_logs")
}

/**
 * ------------------------------------------------------------------------
 */
/**
 * Phase 8/9 — Operations Center & Dispatch Center
 * Share one migration/model group: both read and write the same live-status
 * surface on Availability/Booking, so splitting them would only duplicate
 * the same columns under two names.
 */
/**
 * ------------------------------------------------------------------------
 */

enum OpsStatus {
  scheduled
  boarding
  in_progress
  delayed
  completed
  cancelled

  @@map("ops_status")
}

enum OpsEventType {
  status_changed
  note
  delay_reported
  checkin
  incident_reported
  route_changed
  customer_notified

  @@map("ops_event_type")
}

enum IncidentSeverity {
  low
  medium
  high
  critical

  @@map("incident_severity")
}

enum IncidentCategory {
  medical
  vehicle
  weather
  guest_behavior
  other

  @@map("incident_category")
}

enum IncidentStatus {
  open
  investigating
  resolved

  @@map("incident_status")
}

/// Append-only operations timeline for a departure — status transitions,
/// delay reports, check-ins, route changes, and internal notes all land
/// here as one feed (mirrors BookingStatusEvent's append-only pattern).
model OpsEvent {
  id             String       @id @default(cuid())
  workspaceId    String       @map("workspace_id")
  availabilityId String       @map("availability_id")
  type           OpsEventType
  fromStatus     OpsStatus?   @map("from_status")
  toStatus       OpsStatus?   @map("to_status")
  message        String?
  actorUserId    String?      @map("actor_user_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  availability Availability @relation(fields: [workspaceId, availabilityId], references: [workspaceId, id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, availabilityId, createdAt])
  @@map("ops_events")
}

/// Dispatch Center incident log. `availabilityId` is nullable — some
/// incidents (a vehicle breakdown discovered in the yard) aren't tied to a
/// specific departure.
model IncidentReport {
  id              String           @id @default(cuid())
  workspaceId     String           @map("workspace_id")
  availabilityId  String?          @map("availability_id")
  severity        IncidentSeverity @default(medium)
  category        IncidentCategory @default(other)
  status          IncidentStatus   @default(open)
  description     String
  resolutionNotes String?          @map("resolution_notes")
  resolvedAt      DateTime?        @map("resolved_at") @db.Timestamptz(6)
  reportedById    String?          @map("reported_by")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  availability Availability? @relation(fields: [workspaceId, availabilityId], references: [workspaceId, id], onDelete: Restrict)
  reportedBy   User?         @relation(fields: [reportedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, availabilityId])
  @@map("incident_reports")
}

