# Tripistic environment configuration
# Copy to .env and fill in values. NEVER commit real secrets.
# The app boots without the optional integrations (Stripe, email, AI, storage)
# configured — each degrades gracefully (payment collection / email delivery
# is unavailable, but nothing else breaks) until you fill in its section.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tripistic

# ---------------------------------------------------------------------------
# Auth (NextAuth / Auth.js)
# Generate a secret with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seed bootstrap (optional — used only by `npm run db:seed`)
# When set, the seed creates/updates a platform admin account.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ---------------------------------------------------------------------------
# Stripe (guest payments and Tripistic SaaS subscriptions)
# Required for online guest payment collection and self-serve plan billing;
# the app still boots and every non-payment route works with these unset,
# but a public booking for a paid tour will fail at the checkout-session
# step until STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are configured.
# Per-operator Stripe Connect Express payouts use destination charges.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe Billing recurring Price IDs. These are Tripistic subscription prices,
# not traveler payment prices. Set from Stripe Dashboard or seed provider_price_id
# values in plan_prices.
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_YEARLY=
STRIPE_PRICE_OPERATOR_MONTHLY=
STRIPE_PRICE_OPERATOR_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=
# Days a past-due SaaS subscription remains in local grace after failed invoice
# payment before support/admin action should suspend access.
SUBSCRIPTION_PAYMENT_GRACE_DAYS=7
# Platform fee for traveler booking destination charges, in basis points.
# 0 means 0% commission. Keep this aligned with public pricing claims.
TRIPISTIC_PLATFORM_FEE_BPS=0
# Comma-separated ISO country list where Tripistic enables Connect onboarding.
# Launch default is US; expand only after legal, Stripe, and support readiness.
TRIPISTIC_CONNECT_COUNTRIES=US
# Base URL Stripe Checkout redirects back to on success/cancel — defaults to
# APP_URL above when unset. The app appends /book/confirmation/[publicToken]
# (success) or /book/[workspaceSlug]/[tourSlug] (cancel) itself.
STRIPE_SUCCESS_URL=http://localhost:3000
STRIPE_CANCEL_URL=http://localhost:3000
# Minutes a pending, unpaid public booking holds its seats before the
# admin-triggered expiration sweep (POST /api/admin/payments/expire-pending)
# cancels it and releases capacity. Stripe requires Checkout Sessions to
# live at least 30 minutes, so values below 30 are clamped up to it.
PAYMENT_PENDING_EXPIRY_MINUTES=30

# ---------------------------------------------------------------------------
# Email (Phase 5 CRM & communication — required for booking confirmation,
# T-24h reminder, review-request, and team-invitation emails to actually
# deliver. The app still boots and every non-email route works with these
# unset; a send is instead recorded as a `failed` Message row and logged
# server-side rather than breaking the booking/status/invitation action
# that triggered it. Point SMTP_HOST/PORT/USER/PASS at any SMTP-speaking
# provider (Postmark, SES, Resend's SMTP interface, Mailgun, a real Gmail
# account for local testing, etc.) — there's no provider-specific SDK.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# AI providers (Phase 7+ — placeholders only for now)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_URL=
AI_MODEL_DEFAULT=

# ---------------------------------------------------------------------------
# v2.0.0 Enterprise platform
# ---------------------------------------------------------------------------
# Root domain used for platform subdomain routing, e.g. acme.tripistic.com.
ROOT_DOMAIN=tripistic.com
NEXT_PUBLIC_ROOT_DOMAIN=tripistic.com
# Comma-separated platform subdomains that must never be treated as tenant storefronts.
RESERVED_PLATFORM_HOSTS=admin,api,app,assets,cdn,dashboard,docs,help,mail,status,support,www
# Hostname operators CNAME to when custom domains are enabled.
CUSTOM_DOMAIN_CNAME_TARGET=cname.tripistic.example.com
# Cloudflare for SaaS Custom Hostnames. Leave blank for manual provider mode.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_CUSTOM_HOSTNAME_DCV_METHOD=txt
# Cron/internal secrets for scheduled domain health polling and middleware host-cache lookup.
CRON_SECRET=
DOMAIN_CRON_SECRET=
HOSTNAME_CACHE_SECRET=
HOSTNAME_CACHE_INTERNAL_URL=http://localhost:3000
HOSTNAME_EDGE_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# File storage (S3-compatible — placeholders only for now)
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Marketing analytics (public website only)
#
# Every tag below is optional. A provider loads only when its variable is set
# AND the visitor has consented to the matching cookie category, so leaving
# these blank means no third-party analytics requests are made at all.
# ---------------------------------------------------------------------------
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (analytics consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Tag Manager container ID, e.g. GTM-XXXXXXX (analytics consent)
NEXT_PUBLIC_GTM_ID=
# Microsoft Clarity project ID (analytics consent)
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Meta (Facebook) Pixel ID (marketing consent)
NEXT_PUBLIC_META_PIXEL_ID=
# LinkedIn Insight Tag partner ID (marketing consent)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# Google Search Console HTML tag verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
