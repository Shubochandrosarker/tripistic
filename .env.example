# Tripistic environment configuration
# Copy to .env and fill in values. NEVER commit real secrets.
# The app boots without the optional integrations (Stripe, email, AI, storage) —
# leave those blank until their phase ships.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tripistic

# ---------------------------------------------------------------------------
# Auth (NextAuth / Auth.js)
# Generate a secret with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seed bootstrap (optional — used only by `npm run db:seed`)
# When set, the seed creates/updates a platform admin account.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ---------------------------------------------------------------------------
# Stripe (Phase 4 payments / Phase 10 billing — placeholders only for now)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Email (Phase 5 communication — placeholders only for now)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# AI providers (Phase 7+ — placeholders only for now)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_URL=
AI_MODEL_DEFAULT=

# ---------------------------------------------------------------------------
# File storage (S3-compatible — placeholders only for now)
# ---------------------------------------------------------------------------
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
