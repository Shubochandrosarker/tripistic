# Tripistic environment configuration
# Copy to .env and fill in values. NEVER commit real secrets.
# The app boots without the optional integrations (Stripe, email, AI, storage) —
# leave those blank until their phase ships.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tripistic

# ---------------------------------------------------------------------------
# Auth (NextAuth / Auth.js)
# Generate a secret with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Seed bootstrap (optional — used only by `npm run db:seed`)
# When set, the seed creates/updates a platform admin account.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# ---------------------------------------------------------------------------
# Stripe (Phase 4 payments — required for online guest payment collection;
# the app still boots and every non-payment route works with these unset,
# but a public booking for a paid tour will fail at the checkout-session
# step until STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are configured.
# Phase 10 SaaS billing, and per-operator Stripe Connect payouts, are not
# built yet and reuse these same variables when they ship.)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Base URL Stripe Checkout redirects back to on success/cancel — defaults to
# APP_URL above when unset. The app appends /book/confirmation/[publicToken]
# (success) or /book/[workspaceSlug]/[tourSlug] (cancel) itself.
STRIPE_SUCCESS_URL=http://localhost:3000
STRIPE_CANCEL_URL=http://localhost:3000
# Minutes a pending, unpaid public booking holds its seats before the
# admin-triggered expiration sweep (POST /api/admin/payments/expire-pending)
# cancels it and releases capacity. Stripe requires Checkout Sessions to
# live at least 30 minutes, so values below 30 are clamped up to it.
PAYMENT_PENDING_EXPIRY_MINUTES=30

# ---------------------------------------------------------------------------
# Email (Phase 5 communication — placeholders only for now)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# AI providers (Phase 7+ — placeholders only for now)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_GATEWAY_URL=
AI_MODEL_DEFAULT=

# ---------------------------------------------------------------------------
# File storage (S3-compatible — placeholders only for now)
# ---------------------------------------------------------------------------
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
